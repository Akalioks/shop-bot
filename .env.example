# 1) Telegram bot token from @BotFather (a NEW bot for the shop)
BOT_TOKEN=

# 2) Owners' Telegram ids (from @userinfobot), several: 111,222
ADMIN_IDS=

# 3) Public HTTPS address of the shop page (after hosting), ending with /app/
#    Telegram opens Mini Apps only over HTTPS.
WEBAPP_URL=http://localhost:8080/app/

# 4) Optional: card payments. @BotFather → your bot → Payments → e.g. Stripe TEST → paste the token.
#    Empty = customers pay on pickup / delivery.
PAYMENT_PROVIDER_TOKEN=
CURRENCY=EUR

# true = demo shop: visitors can try /admin with their own test orders
DEMO_MODE=true
SHOP_NAME=Nordic Home
TIMEZONE=Europe/Tallinn

# Web server
HOST=0.0.0.0
PORT=8080

# Local testing in a normal browser without Telegram (http://localhost:8080/app/).
# NEVER set to true on a real server.
DEV_MODE=false
DEV_USER_ID=1

DATABASE_URL=sqlite+aiosqlite:///shop.db
